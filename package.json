{
  "name": "dsh-ai-launcher",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "右侧栏「AI 网页」启动面板：DeepSeek、豆包、通义千问、ChatGPT、Kimi、智谱清言等常用 AI 网页版一键打开，站点可自行增删。",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "launcher",
    "ai",
    "sidebar"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "license": "MIT"
}
